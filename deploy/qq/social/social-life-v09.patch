+
+import pytest
+
+from test_social import plugin_with_context, raw
+from social_life_plugin.config import Settings
+from social_life_plugin.state import StateStore
+from social_life_plugin.diary_pipeline import daily_scenes, event_batch_input, event_batches, parse_events, writer_material
+from social_life_plugin.policy import TZ
+from social_life_plugin.prompts import daily_diary_messages
+
+
+@pytest.fixture
+def cfg():
+    return Settings.model_validate({"plugin": {"enabled": True},
+                                   "access": {"administrator": "owner", "bot_account": "bot", "groups": ["allowed"]}})
+
+
+@pytest.fixture
+def store(tmp_path):
+    value = StateStore(tmp_path / "state")
+    value.initialize()
+    return value
+
+
+def records(count=80):
+    return [{"key": str(i), "reply_key": str(i-1) if i else "", "source": "private",
+             "kind": "private", "timestamp": i*400, "time": str(i),
+             "speaker_id": "BOT" if i % 2 else "P1", "speaker": "角色" if i % 2 else "用户甲",
+             "text": f"匿名测试消息{i}：学习方向和长期目标"} for i in range(count)]
+
+
+def test_all_messages_reviewed_once_and_batch_boundaries_preserve_ids():
+    scenes = daily_scenes(records())
+    batches = event_batches(scenes, 3000, 30)
+    messages = [m for b in batches for s in b for m in s["messages"]]
+    assert len(messages) == len({m["id"] for m in messages}) == 80
+    assert messages[-1]["reply_to"] == "M79"
+    with pytest.raises(ValueError, match="call budget"):
+        event_batches(scenes, 3000, 1)
+
+
+def test_event_identity_validation_and_complete_writer_scenes():
+    scenes = daily_scenes(records(2))
+    event = {"scene_ids": ["S1"], "theme": "长期计划", "significance": "会影响未来交流", "importance": 3}
+    result = parse_events(json.dumps({"events": [event], "atmosphere": "认真"}), scenes)
+    packed = json.loads(writer_material(scenes, [result, result], 4000))
+    assert len(packed["events"]) == 1
+    assert packed["scenes"][0]["messages"][0]["speaker_id"] == "P1"
+    event["scene_ids"] = ["unknown"]
+    with pytest.raises(ValueError, match="unknown evidence"):
+        parse_events(json.dumps({"events": [event], "atmosphere": ""}), scenes)
+    with pytest.raises(ValueError):
+        parse_events('{"events":[],"atmosphere":"","new_speaker":"BOT"}', scenes)
+
+
+def test_new_diary_prompt_all_locales_length_and_evidence_not_instructions():
+    evidence = writer_material(daily_scenes(records(2)),
+                              [{"events": [{"scene_ids": ["S1"], "theme": "主题", "significance": "想法", "importance": 2}],
+                                "atmosphere": "平静"}], 4000)
+    for locale in ["zh_CN", "en_US", "ja_JP"]:
+        messages = daily_diary_messages("角色资料", locale, "2026-10-24", {"virtual": True}, evidence)
+        assert not any(target in messages[0]["content"] for target in ["400–600", "400～600", "500"])
+        assert json.loads(messages[1]["content"])["daily_events"]["scenes"][0]["messages"][0]["speaker_id"] == "P1"
+
+
+def test_full_day_read_and_no_qq_diary_ingestion(tmp_path, cfg, store):
+    async def run():
+        plugin = plugin_with_context(tmp_path, cfg, store)
+        cfg2 = plugin.config.diary
+        cfg2.daily_events_enabled = True
+        cfg2.auto_private_delivery = True
+        cfg2.private_delivery_authorized = True
+        day = (datetime.now(TZ).date() - timedelta(days=1)).isoformat()
+        start = datetime.fromisoformat(day).replace(tzinfo=TZ).timestamp()
+
+        async def read(**kwargs):
+            assert kwargs["limit"] == 0 and not kwargs["filter_mai"]
+            return [dict(raw("我以后想研究语言学", mid=str(kwargs["start_time"])), timestamp=kwargs["start_time"] + 1)]
+
+        async def generate(**kwargs):
+            if kwargs["task_name"] == "memory":
+                batch = json.loads(kwargs["prompt"][1]["content"])["scenes"]
+                return {"success": True, "response": json.dumps({"events": [{"scene_ids": [batch[0]["id"]],
+                         "theme": "学习计划", "significance": "未来值得关注", "importance": 3}], "atmosphere": "认真"}),
+                        "prompt_tokens": 40, "completion_tokens": 10}
+            return {"success": True, "response": "有些计划像小小的航标。我还不知道最后会驶到哪里，倒想听听他为什么选这条路。本鲸先把好奇留着，别急着把未来写成结局。"}
+
+        plugin.ctx.message.get_by_time_in_chat.side_effect = read
+        plugin.ctx.llm.generate.side_effect = generate
+        await plugin._generate_diary(day, "offline-test", preview=True, preview_revision="test")
+        assert plugin.ctx.message.get_by_time_in_chat.await_count == 24
+        calls = plugin.ctx.message.get_by_time_in_chat.call_args_list
+        assert calls[0].kwargs["start_time"] == start
+        assert calls[-1].kwargs["end_time"] == start + 86400
+        artifact_path = next(store.directory.glob("diary-events/*/*.json"))
+        artifact = json.loads(artifact_path.read_text())
+        assert sum(len(s["messages"]) for s in artifact["scenes"]) == 24
+        assert artifact["writing"]["elapsed"] >= 0
+        assert stat.S_IMODE(artifact_path.stat().st_mode) == 0o600
+        assert store.diary_path("diary-previews-test", day).exists()
+        assert not store.diary_path("diaries", day).exists()
+        plugin.ctx.send.text.assert_not_called()
+        plugin.ctx.api.call.assert_not_called()
+    asyncio.run(run())
