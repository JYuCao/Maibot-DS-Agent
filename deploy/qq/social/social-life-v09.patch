+def test_admin_revision_preserves_previous_and_rejects_stale_digest(store):
+    import hashlib
+    path = store.save_diary("diaries", "2026-10-24", "原始私密日记")
+    original = path.read_bytes()
+    digest = hashlib.sha256(original).hexdigest()
+    result = store.revise_diary("diaries", "2026-10-24", digest, "修改后的日记", False)
+    assert (store.directory / result["previous_version"]).read_bytes() == original
+    with pytest.raises(ValueError, match="changed"):
+        store.revise_diary("diaries", "2026-10-24", digest, "不应写入", False)
+    result = store.revise_diary("diaries", "2026-10-24", hashlib.sha256(path.read_bytes()).hexdigest(), "", True)
+    assert result["archived"] and not path.exists()
+    assert (store.directory / result["previous_version"]).exists()
+
