+def test_compact_event_input_preserves_every_identity_and_reply():
+    scenes = daily_scenes(records(12))
+    payload = event_batch_input(scenes)
+    fields = payload["message_fields"]
+    restored = [dict(zip(fields, row, strict=True)) for s in payload["scenes"] for row in s["messages"]]
+    expected = [m for s in scenes for m in s["messages"]]
+    assert restored == [{key: m[key] for key in fields} for m in expected]
+    assert all(payload["speakers"][m["speaker_id"]] == m["speaker"] for m in expected)
+    assert len(json.dumps(payload)) < len(json.dumps({"scenes": scenes}))
