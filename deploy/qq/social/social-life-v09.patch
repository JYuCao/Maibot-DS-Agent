+    def save_diary_artifact(self, directory: str, day: str, payload: Dict[str, Any]) -> Path:
+        """Private immutable evidence and drafts, separate from every memory/chat source."""
+        path = self.diary_path(directory, day).with_suffix(".json")
+        if path.is_symlink():
+            raise ValueError("Diary artifact cannot be a symbolic link")
+        descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=".events-")
+        try:
+            self._preserve_mount_owner(Path(temporary))
+            with os.fdopen(descriptor, "w", encoding="utf-8") as output:
+                json.dump(payload, output, ensure_ascii=False, indent=2)
+                output.flush()
+                os.fsync(output.fileno())
+            os.link(temporary, path)
+        finally:
+            os.unlink(temporary)
+        return path
+
+
+    def revise_diary(self, directory: str, day: str, expected_sha256: str, text: str, archive: bool) -> Dict[str, Any]:
+        """Explicit admin edits preserve the previous version; removal is reversible archiving."""
+        with self.diary_edit_lock:
+            path = self.diary_path(directory, day)
+            original = path.read_bytes()
+            digest = hashlib.sha256(original).hexdigest()
+            if not expected_sha256 or digest != expected_sha256:
+                raise ValueError("Diary changed; read its current SHA-256 before editing")
+            backup = self.diary_path("diary-versions/" + uuid4().hex, day)
+            os.link(path, backup)
+            if archive:
+                path.unlink()
+                return {"day": day, "archived": True, "previous_version": str(backup.relative_to(self.directory))}
+            descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=".revision-")
+            try:
+                self._preserve_mount_owner(Path(temporary))
+                with os.fdopen(descriptor, "w", encoding="utf-8") as output:
+                    output.write(f"# {day}\n\n{text.strip()}\n")
+                    output.flush()
+                    os.fsync(output.fileno())
+                os.replace(temporary, path)
+            finally:
+                if os.path.exists(temporary):
+                    os.unlink(temporary)
+            return {"day": day, "updated": True, "previous_version": str(backup.relative_to(self.directory))}
